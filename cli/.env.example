# Ghost-PM Configuration
# Copy this file to .env and fill in your values

# LLM API Key (pick one)
GEMINI_API_KEY=your-gemini-api-key-here
# OPENAI_API_KEY=your-openai-api-key-here

# LLM Model (default: gemini)
GHOST_MODEL=google:gemini-2.0-flash

# Supabase (auto-filled by ghost connect)
SUPABASE_URL=
SUPABASE_KEY=

# Room (auto-filled by ghost connect)
GHOST_ROOM_ID=
GHOST_MEMBER_NAME=
